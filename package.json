  "dependencies": { "express": "^5.1.0", "playwright": "^1.56.0", "react": "^19.2.0", "react-dom": "^19.2.0", "lucide-react": "^0.468.0" },
  "devDependencies": { "vite": "^7.1.0", "concurrently": "^9.2.0" },
  "engines": { "node": ">=22.12" }
}
